# ==============================================================================
# ClubSphere Backend Environment Configuration (.env.example)
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
APP_NAME=ClubSphere
API_V1_PREFIX=/api/v1
DEBUG=true

# Database Connection (Neon Postgres)
# Neon Postgres is the primary supported data store for application data.
# File-based SQLite is rejected at startup so users can never be persisted locally; only
# in-memory SQLite (sqlite:///:memory:) is permitted, and only for automated tests.
#
# Primary pooled connection string (port 5432 with pgbouncer):
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct / Unpooled connection for Alembic DDL migrations:
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_CONNECT_TIMEOUT=10

# Schema management
# true  -> create missing tables on startup (handy for local dev)
# false -> rely on `alembic upgrade head` (recommended for production)
AUTO_CREATE_SCHEMA=true

# JWT Security
# Generate secure random secret with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_FOR_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=clubsphere-uploads
AZURE_STORAGE_USE_EMULATOR=true
LOCAL_UPLOAD_DIR=./uploads

# Upload Limits & File Security
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Rate Limiting
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60
