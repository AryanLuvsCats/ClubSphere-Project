# ==============================================================================
# ClubSphere Production Environment Configuration Template (.env.production.example)
# ==============================================================================
# Copy this file to .env.production and supply real secrets.
# IMPORTANT: Never commit .env.production or any file containing real secrets to Git!
# ==============================================================================

# Application Environment (Must be set to production for deployment)
ENVIRONMENT=production
APP_NAME=ClubSphere
API_V1_PREFIX=/api/v1
DEBUG=false

# Database Connection (Azure SQL Database Production)
# Azure SQL Database is the supported production relational data store.
DATABASE_URL=mssql+pyodbc://clubsphereadmin:YOUR_URL_ENCODED_PASSWORD@clubsphere-sql-srv.database.windows.net:1433/clubspheredb?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# Direct connection string used for running Alembic DDL migrations:
DATABASE_URL_UNPOOLED=mssql+pyodbc://clubsphereadmin:YOUR_URL_ENCODED_PASSWORD@clubsphere-sql-srv.database.windows.net:1433/clubspheredb?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_ENCRYPT=yes
AZURE_SQL_TRUST_SERVER_CERTIFICATE=no

# Schema Management in Production
# MUST be false in production. Database migrations must be applied using `alembic upgrade head`.
AUTO_CREATE_SCHEMA=false

# JWT Security
# REQUIRED: Must be a cryptographically random, high-entropy secret key of at least 32 characters.
# Generate on Linux/macOS with: openssl rand -hex 32
# Generate on PowerShell with: [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET_KEY=GENERATE_AND_REPLACE_WITH_A_SECURE_32_CHAR_RANDOM_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Host, Proxy & CORS Security (No Wildcards in Production!)
# Set CORS_ORIGINS to your exact frontend domain(s)
CORS_ORIGINS=https://clubsphere.university.edu

# Set ALLOWED_HOSTS to your exact server domain(s) / IP(s)
ALLOWED_HOSTS=clubsphere.university.edu,backend

# Set TRUSTED_PROXY_IPS to the IP address or subnet of the Nginx container / gateway
# For Docker Compose bridge network, typically 127.0.0.1 or frontend container IP
TRUSTED_PROXY_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8

# Transport Security
FORCE_HTTPS=true
HSTS_SECONDS=31536000
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# Azure Blob Storage (Cloud File Uploads in Production)
# Set AZURE_STORAGE_USE_EMULATOR to false in production to write to Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourstorageaccount;AccountKey=yourStorageAccountKey==;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=clubsphere-media
AZURE_STORAGE_USE_EMULATOR=false
LOCAL_UPLOAD_DIR=/app/uploads

# File Upload Size Limits & Types
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Production Rate Limiting
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=20/minute
RATE_LIMIT_LOGIN_ATTEMPTS=20
RATE_LIMIT_REGISTER_ATTEMPTS=20
RATE_LIMIT_REFRESH_ATTEMPTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BLOCK_SECONDS=60
