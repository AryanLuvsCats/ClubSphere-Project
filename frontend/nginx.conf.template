# Nginx config template for the official nginx image.
# The image's entrypoint renders this file with envsubst at container start.
#   BACKEND_SCHEME + BACKEND_HOST  e.g. https + clubsphere-backend.onrender.com
# Local Docker Compose uses the Dockerfile defaults: http + backend:8000.
server {
    listen 80;
    server_name _;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/x-javascript
        application/json
        application/xml
        application/xml+rss
        image/svg+xml;

    # Client-side SPA static assets root
    root /usr/share/nginx/html;
    index index.html;

    # TLS is terminated by the platform edge (Render) or an upstream proxy.
    # These settings also work for plain http:// backend targets in Compose.
    proxy_ssl_server_name on;

    # Reverse proxy: health checks
    location = /health {
        proxy_pass ${BACKEND_SCHEME}://${BACKEND_HOST}/health;
        proxy_http_version 1.1;
        # Do not forward the public frontend Host: Render's edge routes by it.
        # With no explicit Host, Nginx sends $proxy_host (the backend host).
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }

    # Reverse proxy: backend API routes
    location /api/ {
        proxy_pass ${BACKEND_SCHEME}://${BACKEND_HOST}/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # Host is left unset so Nginx uses $proxy_host (the backend host),
        # which Render's edge router expects.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }

    # Static Assets with aggressive caching
    location ~* \.(?:css|js|jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA Client-Side Routing: fallback to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Security Headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
}
